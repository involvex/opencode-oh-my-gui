{
	"name": "@involvex/oh-my-gui",
	"version": "0.3.0",
	"description": "opencode gui plugin",
	"keywords": [
		"opencode",
		"opencode-plugin",
		"plugin"
	],
	"license": "MIT",
	"author": "involvex",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./gui-experimental": "./dist/gui-experimental.cjs"
	},
	"main": "src/index.ts",
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"verify": "bun run format && bun run lint:fix && bun check",
		"prebuild": "bun run verify",
		"dev": "bun run dev.ts",
		"build": "bun run build:gui",
		"build:gui": "vite build",
		"dev:gui": "vite build --watch",
		"format": "prettier . --write",
		"lint": "eslint . --ignore-pattern dist",
		"lint:fix": "eslint . --fix --ignore-pattern dist",
		"setup": "bun run setup.ts",
		"typecheck": "tsc --noEmit",
		"unregister": "bun run unregister.ts"
	},
	"overrides": {
		"effect": "4.0.6"
	},
	"dependencies": {
		"@opencode/plugin": "^2.2.5",
		"@opencode/sdk": "^2.2.5",
		"effect": "^4.0.6",
		"@opentui/core": ">=0.8.1",
		"solid-js": ">=1.9.18",
		"@opentui/solid": "0.8.1"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.6.6",
		"electron": "^45.2.1",
		"eslint": "^10.14.0",
		"prettier": "^3.9.6",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.3.5",
		"vite-plugin-solid": "^2.11.15"
	}
}
