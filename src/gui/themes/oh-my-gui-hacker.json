{
	"$schema": "https://opencode.ai/desktop-theme.json",
	"name": "Oh My GUI Hacker",
	"id": "oh-my-gui-hacker",
	"light": {
		"palette": {
			"neutral": "#eef6ee",
			"ink": "#0d2818",
			"primary": "#0f8a3c",
			"accent": "#7a2fb0",
			"success": "#1a9b4a",
			"warning": "#9a8a12",
			"error": "#c42828",
			"info": "#1a7a5c",
			"interactive": "#0f8a3c",
			"diffAdd": "#2a9b5a",
			"diffDelete": "#c42828"
		},
		"overrides": {
			"text-weak": "#4a6b55",
			"syntax-comment": "#5a7a62",
			"syntax-keyword": "#7a2fb0",
			"syntax-string": "#0f8a3c",
			"syntax-primitive": "#1a7a5c",
			"syntax-variable": "#0d2818",
			"syntax-property": "#12805a",
			"syntax-type": "#7a7010",
			"syntax-constant": "#7a2fb0",
			"syntax-operator": "#0f8a3c",
			"syntax-punctuation": "#0d2818",
			"syntax-object": "#0d2818"
		}
	},
	"dark": {
		"palette": {
			"neutral": "#000000",
			"ink": "#39ff14",
			"primary": "#2eff6a",
			"accent": "#c770ff",
			"success": "#2eff6a",
			"warning": "#c8e050",
			"error": "#ff5555",
			"info": "#00ff88",
			"interactive": "#2eff6a",
			"diffAdd": "#2eff6a",
			"diffDelete": "#ff5555"
		},
		"overrides": {
			"background-base": "#000000",
			"background-weak": "#050805",
			"background-strong": "#000000",
			"surface-base": "#050805",
			"surface-raised-base": "#0a120a",
			"surface-raised-base-hover": "#0f1a0f",
			"surface-brand-base": "#0d2814",
			"surface-brand-hover": "#14381c",
			"surface-interactive-base": "#0a1a0c",
			"surface-interactive-hover": "#0f2412",
			"surface-interactive-weak": "#0a1a0c",
			"input-base": "#050805",
			"input-hover": "#0a120a",
			"input-active": "#0a1a0c",
			"input-focus": "#0a1a0c",
			"input-selected": "#0f2412",
			"text-base": "#39ff14",
			"text-weak": "#2db812",
			"text-weaker": "#1e7a0c",
			"icon-base": "#39ff14",
			"border-base": "#1a4a22",
			"border-hover": "#2d6b30",
			"border-focus": "#2eff6a",
			"border-selected": "#2eff6a",
			"border-weak-base": "#14301a",
			"border-weak-hover": "#1a4a22",
			"border-weak-focus": "#2eff6a",
			"border-weak-selected": "#2eff6a99",
			"border-weaker-base": "#0a1a0e",
			"border-strong-base": "#2d6b30",
			"syntax-comment": "#2d6b30",
			"syntax-keyword": "#c770ff",
			"syntax-string": "#00cc33",
			"syntax-primitive": "#00ff88",
			"syntax-variable": "#39ff14",
			"syntax-property": "#2eff6a",
			"syntax-type": "#c8e050",
			"syntax-constant": "#c770ff",
			"syntax-operator": "#2eff6a",
			"syntax-punctuation": "#39ff14",
			"syntax-object": "#39ff14",
			"markdown-heading": "#2eff6a",
			"markdown-text": "#39ff14",
			"markdown-link": "#00ff88",
			"markdown-code": "#00cc33",
			"markdown-code-block": "#39ff14",
			"markdown-block-quote": "#2db812",
			"markdown-strong": "#c8e050"
		},
		"v2Overrides": {
			"v2-text-text-base": "#39ff14",
			"v2-text-text-muted": "#2db812",
			"v2-text-text-faint": "#1e7a0c",
			"v2-icon-icon-base": "#39ff14",
			"v2-icon-icon-muted": "#2db812",
			"v2-icon-icon-faint": "#1e7a0c",
			"v2-background-bg-base": "#000000",
			"v2-background-bg-deep": "#000000",
			"v2-background-bg-input": "#050805",
			"v2-background-bg-layer-01": "#050805",
			"v2-background-bg-layer-02": "#0a120a",
			"v2-background-bg-layer-03": "#0f1a0f",
			"v2-background-bg-button-neutral": "#0a1a0c",
			"v2-background-bg-accent": "var(--v2-green-600)",
			"v2-text-text-accent": "var(--v2-green-400)",
			"v2-text-text-accent-hover": "var(--v2-green-300)",
			"v2-icon-icon-accent": "var(--v2-green-400)",
			"v2-icon-icon-accent-hover": "var(--v2-green-300)",
			"v2-border-border-muted": "#0d2814",
			"v2-border-border-base": "#1a4a22",
			"v2-border-border-strong": "#2d6b30",
			"v2-border-border-focus": "var(--v2-green-500)",
			"v2-overlay-simple-tab-active-scrim": "#0d2814cc",
			"v2-overlay-simple-tab-hover-scrim": "#0a1a0c88",
			"v2-overlay-simple-tab-scrim": "#00000000"
		}
	}
}
